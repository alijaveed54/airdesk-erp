function fallbackValue(
  invoiceValues: Record<string, unknown>,
  customerValues: Record<string, unknown>,
  invoiceField?: SchemaField,
  customerField?: SchemaField,
) {
  return (
    firstValue(invoiceValues[invoiceField?.name || ""]) ||
    firstValue(customerValues[customerField?.name || ""])
  );
}

function buildShipmentInput({
  record,
  fields,
  customerValues,
  customerFields,
}: {
  record: AirtableRecord;
  fields: FieldMap;
  customerValues: Record<string, unknown>;
  customerFields: ReturnType<typeof customerFieldMap>;
}): TfmShipmentInput {
  const invoiceValues = record.fields || {};
  const total = numberValue(invoiceValues[fields.total?.name || ""]);
  const advance = numberValue(invoiceValues[fields.advance?.name || ""]);
  const codAmount = Math.max(Number((total - advance).toFixed(2)), 0);

  return {
    recordId: record.id,
    orderNo:
      firstValue(invoiceValues[fields.orderNo?.name || ""]) || record.id,
    customerName: fallbackValue(
      invoiceValues,
      customerValues,
      fields.customerName,
      customerFields.name,
    ),
    phone: normalizePhone(
      fallbackValue(
        invoiceValues,
        customerValues,
        fields.phone,
        customerFields.phone,
      ),
    ),
    email: fallbackValue(
      invoiceValues,
      customerValues,
      fields.email,
      customerFields.email,
    ),
    address: fallbackValue(
      invoiceValues,
      customerValues,
      fields.address,
      customerFields.address,
    ),
    city: fallbackValue(
      invoiceValues,
      customerValues,
      fields.city,
      customerFields.city,
    ),
    area: fallbackValue(
      invoiceValues,
      customerValues,
      fields.area,
      customerFields.area,
    ),
    building: fallbackValue(
      invoiceValues,
      customerValues,
      fields.building,
      customerFields.building,
    ),
    street: fallbackValue(
      invoiceValues,
      customerValues,
      fields.street,
      customerFields.street,
    ),
    country: fallbackValue(
      invoiceValues,
      customerValues,
      fields.country,
      customerFields.country,
    ),
    latitude: fallbackValue(
      invoiceValues,
      customerValues,
      fields.latitude,
      customerFields.latitude,
    ),
    longitude: fallbackValue(
      invoiceValues,
      customerValues,
      fields.longitude,
      customerFields.longitude,
    ),
    store: firstValue(invoiceValues[fields.store?.name || ""]) || "Mysmar",
    note: firstValue(invoiceValues[fields.note?.name || ""]),
    content: firstValue(invoiceValues[fields.content?.name || ""]),
    deliveryServiceCode: firstValue(
      invoiceValues[fields.deliveryServiceCode?.name || ""],
    ),
    pieces: Math.max(
      Math.round(numberValue(invoiceValues[fields.pieces?.name || ""])),
      1,
    ),
    totalWeight: numberValue(invoiceValues[fields.weight?.name || ""]),
    totalVolumeWeight: numberValue(
      invoiceValues[fields.volumeWeight?.name || ""],
    ),
    total,
    advance,
    codAmount,
    paymentType: codAmount > 0 ? "COD" : "Prepaid",
    awbNumber: firstValue(invoiceValues[fields.awb?.name || ""]),
    shipmentId: firstValue(invoiceValues[fields.shipmentId?.name || ""]),
  };
}

function validateCreateInput(
  input: TfmShipmentInput,
  fields: FieldMap,
) {
  const errors: string[] = [];
  if (!input.orderNo || input.orderNo.startsWith("rec")) {
    errors.push("Valid Order Number is missing");
  }
  if (!input.customerName) errors.push("Customer name is missing");
  if (!/^9715\d{8}$/.test(input.phone.replace(/\D/g, ""))) {
    errors.push(
      "Customer mobile number is invalid. Use a UAE mobile such as 551280604, 0551280604 or 971551280604",
    );
  }
  if (![input.address, input.area, input.building, input.street].some(Boolean)) {
    errors.push("Delivery address is missing");
  }
  if (!input.city) errors.push("Delivery city is missing");
  if (input.total <= 0) errors.push("Order total is missing or invalid");
  if (input.advance < 0) errors.push("Advance cannot be negative");
  if (input.advance > input.total) {
    errors.push("Advance is greater than order total");
  }
  if (!fields.orderStatus) {
    errors.push("Writable Order Status field is missing");
  }
  if (!fields.courier) {
    errors.push("Writable Courier field is missing");
  }

  return errors;
}

async function patchRecord({
  baseId,
  token,
  table,
  recordId,
  fields,
}: {
  baseId: string;
  token: string;
  table: string;
  recordId: string;
  fields: Record<string, unknown>;
}) {
  if (!Object.keys(fields).length) return;

  const params = new URLSearchParams({ typecast: "true" });
  const response = await fetch(airtableUrl(baseId, table, params), {
    method: "PATCH",
    headers: airtableHeaders(token),
    cache: "no-store",
    body: JSON.stringify({
      records: [{ id: recordId, fields }],
    }),
  });
  const raw = await response.text();
  let data: any = null;

  try {
    data = raw ? JSON.parse(raw) : null;
  } catch {
    data = null;
  }

  if (!response.ok) {
    throw new Error(
      data?.error?.message || data?.error?.error?.message || "Airtable update failed",
    );
  }
}

function commonUpdateFields(
  fields: FieldMap,
  values: {
    status?: string;
    shipmentId?: string;
    lastActionDate?: string;
    error?: string;
  },
) {
  const update: Record<string, unknown> = {};
  const now = new Date().toISOString();

  if (fields.tfmStatus && values.status) {
    update[fields.tfmStatus.name] = values.status;
  }
  if (fields.shipmentId && values.shipmentId) {
    update[fields.shipmentId.name] = fieldValue(
      fields.shipmentId,
      values.shipmentId,
    );
  }
  if (fields.lastActionDate && values.lastActionDate) {
    const date = dateValue(values.lastActionDate, fields.lastActionDate);
    if (date) update[fields.lastActionDate.name] = date;
  }
  if (fields.lastSync) {
    const date = dateValue(now, fields.lastSync);
    if (date) update[fields.lastSync.name] = date;
  }
  if (fields.error) {
    update[fields.error.name] = values.error || "";
  }

  return update;
}

async function saveFailure({
  airtable,
  invoiceTable,
  fields,
  recordId,
  message,
}: {
  airtable: Awaited<ReturnType<typeof getCurrentAirtableBase>>;
  invoiceTable: SchemaTable;
  fields: FieldMap;
  recordId: string;
  message: string;
}) {
  const update = commonUpdateFields(fields, { error: message });

  if (!Object.keys(update).length) return;

  try {
    await patchRecord({
      baseId: airtable.baseId,
      token: airtable.token,
      table: invoiceTable.name,
      recordId,
      fields: update,
    });
  } catch {
    // The original TFM error is more important than a secondary error-field write.
  }
}

export async function POST(request: NextRequest) {
  try {
    const session = await getSession();

    if (!session) {
      return NextResponse.json(
        { success: false, message: "Not authenticated" },
        { status: 401 },
      );
    }

    if (session.role === "Supplier") {
      return NextResponse.json(
        { success: false, message: "Supplier access is not allowed" },
        { status: 403 },
      );
    }

    const body = (await request.json()) as RequestBody;
    const action = body.action;
    const recordIds = unique(
      (Array.isArray(body.recordIds) ? body.recordIds : [])
        .map(String)
        .map((value) => value.trim())
        .filter((value) => value.startsWith("rec")),
    );

    if (!action || !["create", "track", "cancel", "label"].includes(action)) {
      return NextResponse.json(
        { success: false, message: "Valid TFM action is required" },
        { status: 400 },
      );
    }

    if (!recordIds.length) {
      return NextResponse.json(
        { success: false, message: "No Airtable records were selected" },
        { status: 400 },
      );
    }

    const limit = action === "label" ? 1 : action === "track" ? 100 : 50;

    if (recordIds.length > limit) {
      return NextResponse.json(
        {
          success: false,
          message: `Maximum ${limit} record(s) are allowed for ${action}`,
        },
        { status: 400 },
      );
    }

    const airtable = await getCurrentAirtableBase();
    const permissions = airtable as typeof airtable & {
      canEdit?: boolean;
      canDispatch?: boolean;
    };

    if (!airtable.canView) {
      return NextResponse.json(
        { success: false, message: "You cannot view TFM orders" },
        { status: 403 },
      );
    }

    if (
      ["create", "cancel"].includes(action) &&
      !permissions.canEdit &&
      !permissions.canDispatch &&
      session.role !== "Admin"
    ) {
      return NextResponse.json(
        { success: false, message: "You cannot change TFM shipments" },
        { status: 403 },
      );
    }

    if (!isTfmSupportedBase(airtable.baseId)) {
      return NextResponse.json(
        {
          success: false,
          message:
            "TFM integration is available only for BS Order Entry and Tatlumput Siyam Order Entry",
        },
        { status: 400 },
      );
    }

    const configuration = getTfmConfigurationStatus();
    const readiness = {
      create: configuration.bookingReady,
      track: configuration.trackingReady,
      cancel: configuration.cancellationReady,
      label: configuration.labelReady,
    }[action];

    if (!readiness) {
      return NextResponse.json(
        {
          success: false,
          message: `TFM ${action} is not ready. Complete its endpoint, method/body template and enable TFM_ALLOW_LIVE_REQUESTS after sandbox verification.`,
          configuration,
        },
        { status: 400 },
      );
    }

    const supportedBase = getTfmSupportedBase(airtable.baseId);
    const schema = await loadSchema(airtable.baseId, airtable.token);
    const invoiceTable =
      schema.find((table) => table.name === airtable.tables.invoice) ||
      schema.find((table) => table.name === supportedBase?.invoiceTable);

    if (!invoiceTable) {
      throw new Error(
        `Invoice table not found: ${
          airtable.tables.invoice || supportedBase?.invoiceTable
        }`,
      );
    }

    const fields = buildFieldMap(invoiceTable, schema);

    if (!fields.orderNo || !fields.awb) {
      return NextResponse.json(
        {
          success: false,
          message:
            "Order Number and TFM AWB fields are required in the invoice table",
        },
        { status: 400 },
      );
    }

    const records = await fetchRecordsByIds({
      baseId: airtable.baseId,
      token: airtable.token,
      table: invoiceTable.name,
      recordIds,
    });
    const customerTable = fields.customerLink?.options?.linkedTableId
      ? schema.find(
          (table) => table.id === fields.customerLink?.options?.linkedTableId,
        )
      : schema.find((table) => table.name === airtable.tables.customers);
    const customerIds = Array.from(records.values())
      .map((record) =>
        getLinkedRecordId(
          record.fields[fields.customerLink?.name || ""],
        ),
      )
      .filter(Boolean);
    const customers =
      customerTable && customerIds.length
        ? await fetchRecordsByIds({
            baseId: airtable.baseId,
            token: airtable.token,
            table: customerTable.name,
            recordIds: customerIds,
          })
        : new Map<string, AirtableRecord>();
    const customerFields = customerFieldMap(customerTable);
    const results: ActionResult[] = [];

    for (const recordId of recordIds) {
      const record = records.get(recordId);

      if (!record) {
        results.push({
          recordId,
          orderNo: recordId,
          success: false,
          message: "Airtable record was not found",
        });
        continue;
      }

      const customerId = getLinkedRecordId(
        record.fields[fields.customerLink?.name || ""],
      );
      const input = buildShipmentInput({
        record,
        fields,
        customerValues: customers.get(customerId)?.fields || {},
        customerFields,
      });

      const lockKey = `${airtable.baseId}:${recordId}:${action}`;

      if (activeActionLocks.has(lockKey)) {
        results.push({
          recordId,
          orderNo: input.orderNo,
          success: false,
          awbNumber: input.awbNumber,
          shipmentId: input.shipmentId,
          message: "The same TFM action is already running for this order",
        });
        continue;
      }

      activeActionLocks.add(lockKey);

      try {
        if (action === "create") {
          const validationErrors = validateCreateInput(input, fields);

          if (input.awbNumber && !body.confirmExistingAwb) {
            validationErrors.push(
              `Existing AWB ${input.awbNumber} requires explicit rebooking confirmation`,
            );
          }

          if (
            input.awbNumber &&
            body.confirmExistingAwb &&
            !fields.previousAwbs
          ) {
            validationErrors.push(
              "TFM Previous AWBs field is required before replacing an existing AWB",
            );
          }

          if (validationErrors.length) {
            throw new Error(validationErrors.join("; "));
          }

          const created = await createTfmShipment(input);
          const currentPrevious = fields.previousAwbs
            ? listValues(record.fields[fields.previousAwbs.name])
            : [];
          const previousAwbs = unique([
            ...currentPrevious,
            ...(input.awbNumber &&
            normalize(input.awbNumber) !== normalize(created.awbNumber)
              ? [input.awbNumber]
              : []),
          ]).filter(
            (awb) => normalize(awb) !== normalize(created.awbNumber),
          );
          const update: Record<string, unknown> = {
            ...commonUpdateFields(fields, {
              status: created.status,
              shipmentId: created.shipmentId,
              lastActionDate: created.lastActionDate,
              error: "",
            }),
            [fields.awb.name]: fieldValue(fields.awb, created.awbNumber),
          };
          if (!fields.orderStatus || !fields.courier) {
            throw new Error(
              "Writable Order Status and Courier fields are required before creating a TFM AWB",
            );
          }

          update[fields.orderStatus.name] = fieldValue(
            fields.orderStatus,
            "Order Received",
          );
          update[fields.courier.name] = fieldValue(
            fields.courier,
            "TFM",
          );

          const bookingDate = dateValue(
            created.bookingDate,
            fields.bookingDate,
          );

          if (fields.bookingDate && bookingDate) {
            update[fields.bookingDate.name] = bookingDate;
          }
          if (fields.previousAwbs && previousAwbs.length) {
            update[fields.previousAwbs.name] = previousAwbs.join(", ");
          }

          try {
            await patchRecord({
              baseId: airtable.baseId,
              token: airtable.token,
              table: invoiceTable.name,
              recordId,
              fields: update,
            });
          } catch (airtableError) {
            throw new Error(
              `TFM created AWB ${created.awbNumber}, but Airtable could not save it: ${cleanError(
                airtableError,
              )}. Do not create another AWB until this record is reconciled.`,
            );
          }

          results.push({
            recordId,
            orderNo: input.orderNo,
            success: true,
            awbNumber: created.awbNumber,
            shipmentId: created.shipmentId,
            status: created.status,
            message: "TFM shipment created and Airtable updated",
          });
          continue;
        }

        if (!input.awbNumber && !input.shipmentId) {
          throw new Error("TFM AWB or Shipment ID is missing");
        }

        if (action === "track") {
          const tracked = await trackTfmShipment(input);
          const update: Record<string, unknown> = commonUpdateFields(fields, {
            status: tracked.status,
            shipmentId: tracked.shipmentId,
            lastActionDate: tracked.lastActionDate,
            error: "",
          });
          let trackingWarning = "";

          if (
            tracked.awbNumber &&
            normalize(tracked.awbNumber) !== normalize(input.awbNumber)
          ) {
            if (!input.awbNumber) {
              update[fields.awb.name] = fieldValue(
                fields.awb,
                tracked.awbNumber,
              );
            } else if (fields.previousAwbs) {
              const previousAwbs = unique([
                ...listValues(record.fields[fields.previousAwbs.name]),
                input.awbNumber,
              ]).filter(
                (awb) => normalize(awb) !== normalize(tracked.awbNumber),
              );

              update[fields.awb.name] = fieldValue(
                fields.awb,
                tracked.awbNumber,
              );
              update[fields.previousAwbs.name] = previousAwbs.join(", ");
            } else {
              trackingWarning =
                " TFM returned a different AWB, but it was not overwritten because the Previous AWBs field is missing.";
            }
          }

          await patchRecord({
            baseId: airtable.baseId,
            token: airtable.token,
            table: invoiceTable.name,
            recordId,
            fields: update,
          });

          results.push({
            recordId,
            orderNo: input.orderNo,
            success: true,
            awbNumber: tracked.awbNumber,
            shipmentId: tracked.shipmentId,
            status: tracked.status,
            message: `Live TFM tracking synchronized.${trackingWarning}`,
          });
          continue;
        }

        if (action === "cancel") {
          const currentStatus = firstValue(
            record.fields[fields.tfmStatus?.name || ""],
          );

          if (isTerminalTfmStatus(currentStatus)) {
            throw new Error(
              `Shipment cannot be cancelled from terminal status: ${currentStatus}`,
            );
          }

          const cancelled = await cancelTfmShipment(input);

          if (!cancelled.cancelled) {
            throw new Error(
              cancelled.status || "TFM did not confirm cancellation",
            );
          }

          await patchRecord({
            baseId: airtable.baseId,
            token: airtable.token,
            table: invoiceTable.name,
            recordId,
            fields: commonUpdateFields(fields, {
              status: cancelled.status || "Cancelled",
              lastActionDate: cancelled.lastActionDate,
              error: "",
            }),
          });

          results.push({
            recordId,
            orderNo: input.orderNo,
            success: true,
            awbNumber: input.awbNumber,
            shipmentId: input.shipmentId,
            status: cancelled.status,
            message: "TFM shipment cancelled",
          });
          continue;
        }

        const label = await getTfmShipmentLabel(input);

        return new Response(Buffer.from(label.bytes), {
          status: 200,
          headers: {
            "Content-Type": label.contentType,
            "Content-Disposition": `attachment; filename="${label.fileName.replace(
              /["\r\n]/g,
              "",
            )}"`,
            "Cache-Control": "no-store",
            "X-TFM-Order": encodeURIComponent(input.orderNo),
          },
        });
      } catch (error) {
        const message = cleanError(error);
        await saveFailure({
          airtable,
          invoiceTable,
          fields,
          recordId,
          message,
        });
        results.push({
          recordId,
          orderNo: input.orderNo,
          success: false,
          awbNumber: input.awbNumber,
          shipmentId: input.shipmentId,
          message,
        });
      } finally {
        activeActionLocks.delete(lockKey);
      }
    }

    const successful = results.filter((item) => item.success).length;
    const failed = results.length - successful;

    return NextResponse.json({
      success: failed === 0,
      partial: successful > 0 && failed > 0,
      action,
      message:
        failed === 0
          ? `${successful} TFM ${action} action(s) completed`
          : `${successful} completed; ${failed} failed`,
      successful,
      failed,
      results,
    });
  } catch (error) {
    return handleApiError(error, "TFM shipment action failed");
  }
}

import { NextRequest } from "next/server";
import { getSession } from "@/lib/auth";
import {
  airtableFetch,
  airtablePaginatedFetch,
  apiError,
  apiSuccess,
  handleApiError,
} from "@/lib/airtable";

const TABLE_NAME = process.env.FACEBOOK_PAGES_TABLE || "Facebook Pages";

type FacebookPageRecord = {
  id: string;
  fields?: Record<string, unknown>;
  createdTime?: string;
};

function getAdminBaseConfig() {
  const baseId =
    process.env.ERP_ADMIN_BASE_ID ||
    process.env.AUTH_AIRTABLE_BASE_ID ||
    process.env.AIRTABLE_BASE_ID ||
    "";

  const token =
    process.env.AIRTABLE_TOKEN ||
    process.env.AUTH_AIRTABLE_TOKEN ||
    "";

  if (!baseId) {
    throw new Error(
      "ERP_ADMIN_BASE_ID (ya AUTH_AIRTABLE_BASE_ID) .env.local mein missing hai."
    );
  }

  if (!token) {
    throw new Error(
      "AIRTABLE_TOKEN (ya AUTH_AIRTABLE_TOKEN) .env.local mein missing hai."
    );
  }

  return { baseId, token };
}

async function requireUser() {
  const session = await getSession();

  if (!session) {
    throw {
      status: 401,
      message: "Not authenticated",
    };
  }

  if (session.role === "Supplier") {
    throw {
      status: 403,
      message: "Supplier Facebook module access nahi kar sakta.",
    };
  }

  return session;
}

async function requireAdmin() {
  const session = await requireUser();

  if (session.role !== "Admin" && !session.superAdmin) {
    throw {
      status: 403,
      message: "Sirf Admin Facebook Pages manage kar sakta hai.",
    };
  }

  return session;
}

function stringValue(value: unknown) {
  if (Array.isArray(value)) {
    return String(value[0] ?? "").trim();
  }

  return String(value ?? "").trim();
}

function booleanValue(value: unknown) {
  return value === true;
}

function tokenPreview(token: string) {
  const clean = token.trim();

  if (!clean) return "";
  if (clean.length <= 12) return "••••••••";

  return `${clean.slice(0, 6)}••••••${clean.slice(-6)}`;
}

function normalizeRecord(record: FacebookPageRecord) {
  const fields = record.fields || {};
  const token = stringValue(fields["Page Token"]);

  return {
    id: record.id,
    pageName: stringValue(fields["Page Name"]),
    pageId: stringValue(fields["Page ID"]),
    active: booleanValue(fields["Active"]),
    isDefault: booleanValue(fields["Default"]),
    tokenPreview: tokenPreview(token),
    createdAt:
      stringValue(fields["Created"]) ||
      record.createdTime ||
      "",
  };
}

async function getRecord(recordId: string) {
  const { baseId, token } = getAdminBaseConfig();

  return airtableFetch({
    baseId,
    token,
    table: TABLE_NAME,
    recordId,
  }) as Promise<FacebookPageRecord>;
}

function getFacebookGraphVersion() {
  const configured = String(
    process.env.FACEBOOK_GRAPH_API_VERSION || "v25.0"
  )
    .trim()
    .replace(
      /^https?:\/\/graph\.facebook\.com\//i,
      ""
    )
    .replace(/^\/+|\/+$/g, "");

  if (!configured) {
    return "v25.0";
  }

  return configured.toLowerCase().startsWith("v")
    ? configured
    : `v${configured}`;
}

type FacebookAccountPage = {
  id?: string;
  name?: string;
  access_token?: string;
};

type FacebookAccountsResponse = {
  data?: FacebookAccountPage[];
  paging?: {
    next?: string;
  };
  error?: {
    message?: string;
    type?: string;
    code?: number;
    error_subcode?: number;
  };
};

function facebookApiError(
  data: any,
  fallback: string
) {
  const message = stringValue(
    data?.error?.message || fallback
  );

  const details = [
    data?.error?.type
      ? `type: ${data.error.type}`
      : "",
    data?.error?.code !== undefined
      ? `code: ${data.error.code}`
      : "",
    data?.error?.error_subcode !== undefined
      ? `subcode: ${data.error.error_subcode}`
      : "",
  ].filter(Boolean);

  return details.length > 0
    ? `${message} (${details.join(", ")})`
    : message;
}

async function facebookGet(
  pathValue: string,
  accessToken: string,
  params: Record<string, string> = {}
) {
  const cleanPath = String(pathValue || "")
    .trim()
    .replace(/^\/+|\/+$/g, "");

  const url = new URL(
    `https://graph.facebook.com/` +
      `${getFacebookGraphVersion()}/${cleanPath}`
  );

  Object.entries(params).forEach(([key, value]) => {
    url.searchParams.set(key, value);
  });

  const response = await fetch(url, {
    method: "GET",
    headers: {
      Authorization: `Bearer ${accessToken}`,
    },
    cache: "no-store",
  });

  const data = await response.json().catch(() => null);

  if (!response.ok || data?.error) {
    throw {
      status: 400,
      message: facebookApiError(
        data,
        "Facebook token verification failed."
      ),
      error: data,
    };
  }

  return data;
}

async function getPageTokenFromUserToken(
  userAccessToken: string,
  targetPageId: string
) {
  let nextUrl =
    `https://graph.facebook.com/` +
    `${getFacebookGraphVersion()}/me/accounts` +
    `?fields=id,name,access_token&limit=100`;

  while (nextUrl) {
    const response = await fetch(nextUrl, {
      method: "GET",
      headers: {
        Authorization: `Bearer ${userAccessToken}`,
      },
      cache: "no-store",
    });

    const data =
      (await response.json().catch(() => null)) as
        | FacebookAccountsResponse
        | null;

    if (!response.ok || data?.error) {
      throw {
        status: 400,
        message: facebookApiError(
          data,
          "Facebook Pages user token se load nahi huay."
        ),
        error: data,
      };
    }

    const matchingPage = (data?.data || []).find(
      (page) =>
        String(page.id || "").trim() ===
        String(targetPageId).trim()
    );

    if (matchingPage?.access_token) {
      return {
        pageToken: String(
          matchingPage.access_token
        ).trim(),
        pageName: String(
          matchingPage.name || ""
        ).trim(),
      };
    }

    nextUrl = String(
      data?.paging?.next || ""
    ).trim();
  }

  throw {
    status: 400,
    message:
      `Provided User Access Token mein Page ID ` +
      `${targetPageId} available nahi hai. ` +
      `Page permission aur selected Facebook account check karein.`,
  };
}

async function resolveReconnectPageToken(
  suppliedToken: string,
  targetPageId: string
) {
  // First treat the supplied token as a direct Page Access Token.
  try {
    const directPage = await facebookGet(
      "me",
      suppliedToken,
      {
        fields: "id,name",
      }
    );

    const directPageId = String(
      directPage?.id || ""
    ).trim();

    if (directPageId === targetPageId) {
      return {
        pageToken: suppliedToken,
        pageName: String(
          directPage?.name || ""
        ).trim(),
        source: "page" as const,
      };
    }
  } catch {
    // It can still be a valid User token; /me/accounts is checked next.
  }

  const resolved = await getPageTokenFromUserToken(
    suppliedToken,
    targetPageId
  );

  return {
    pageToken: resolved.pageToken,
    pageName: resolved.pageName,
    source: "user" as const,
  };
}

async function testFacebookPage(
  pageId: string,
  pageToken: string
) {
  const graphVersion = getFacebookGraphVersion();

  // A Page token identifies its own Page through /me.
  // This avoids Graph API "Unknown path components: /PAGE_ID"
  // errors while still verifying that the token belongs to the
  // Page ID entered by the Admin.
  const url = new URL(
    `https://graph.facebook.com/${graphVersion}/me`
  );

  url.searchParams.set("fields", "id,name");
  url.searchParams.set("access_token", pageToken);

  const response = await fetch(url, {
    method: "GET",
    cache: "no-store",
  });

  const data = await response.json().catch(() => null);

  if (!response.ok || data?.error) {
    throw {
      status: 400,
      message:
        data?.error?.message ||
        "Facebook Page connection test failed.",
      error: data,
    };
  }

  const tokenPageId = String(data?.id || "").trim();

  if (!tokenPageId) {
    throw {
      status: 400,
      message:
        "Facebook token se Page ID retrieve nahi hui.",
    };
  }

  if (tokenPageId !== String(pageId)) {
    throw {
      status: 400,
      message:
        `Ye token Page ID ${tokenPageId} ka hai, ` +
        `entered Page ID ${pageId} ka nahi.`,
    };
  }

  return {
    id: tokenPageId,
    name: String(data?.name || "").trim(),
  };
}

export async function GET() {
  try {
    await requireUser();
    const { baseId, token } = getAdminBaseConfig();

    const params = new URLSearchParams();
    params.set("sort[0][field]", "Page Name");
    params.set("sort[0][direction]", "asc");

    const records = await airtablePaginatedFetch({
      baseId,
      token,
      table: TABLE_NAME,
      params,
    });

    return apiSuccess({
      pages: records.map(normalizeRecord),
    });
  } catch (error) {
    return handleApiError(error, "Facebook Pages load failed");
  }
}

export async function POST(request: NextRequest) {
  try {
    const session = await requireAdmin();
    const { baseId, token } = getAdminBaseConfig();
    const body = await request.json();

    const pageName = stringValue(body.pageName);
    const pageId = stringValue(body.pageId).replace(/\D/g, "");
    const pageToken = stringValue(body.pageToken);
    const active = body.active !== false;
    const isDefault = body.isDefault === true;

    if (!pageName || !pageId || !pageToken) {
      return apiError(
        "Page Name, Page ID aur Page Token required hain.",
        400
      );
    }

    const testedPage = await testFacebookPage(pageId, pageToken);

    const duplicateParams = new URLSearchParams();
    duplicateParams.set(
      "filterByFormula",
      `{Page ID}='${pageId.replace(/'/g, "\\'")}'`
    );
    duplicateParams.set("maxRecords", "1");

    const duplicate = await airtableFetch({
      baseId,
      token,
      table: TABLE_NAME,
      params: duplicateParams,
    });

    if ((duplicate.records || []).length > 0) {
      return apiError("Ye Facebook Page ID pehle se saved hai.", 409);
    }

    const record = await airtableFetch({
      baseId,
      token,
      table: TABLE_NAME,
      method: "POST",
      fields: {
        fields: {
          "Page Name": testedPage.name || pageName,
          "Page ID": pageId,
          "Page Token": pageToken,
          Active: active,
          Default: isDefault,
          Created: new Date().toISOString(),
          "Created By": session.fullName || session.username,
        },
      },
    });

    return apiSuccess({
      message: `${testedPage.name || pageName} save aur verify ho gaya.`,
      page: normalizeRecord(record),
    });
  } catch (error) {
    return handleApiError(error, "Facebook Page save failed");
  }
}

export async function PATCH(request: NextRequest) {
  try {
    await requireAdmin();
    const { baseId, token } = getAdminBaseConfig();
    const body = await request.json();

    const recordId = stringValue(body.recordId);

    if (!recordId) {
      return apiError("Facebook Page record ID missing hai.", 400);
    }

    if (body.action === "test") {
      const record = await getRecord(recordId);
      const pageId = stringValue(record.fields?.["Page ID"]);
      const pageToken = stringValue(record.fields?.["Page Token"]);

      if (!pageId || !pageToken) {
        return apiError("Saved Page ID ya Page Token missing hai.", 400);
      }

      const testedPage = await testFacebookPage(pageId, pageToken);

      return apiSuccess({
        message: `${testedPage.name} connection successful.`,
      });
    }

    if (body.action === "reconnect") {
      const suppliedToken = stringValue(
        body.accessToken || body.userAccessToken || body.pageToken
      );

      if (!suppliedToken) {
        return apiError(
          "Fresh Facebook User Access Token ya Page Access Token required hai.",
          400
        );
      }

      const record = await getRecord(recordId);
      const savedPageId = stringValue(
        record.fields?.["Page ID"]
      );

      if (!savedPageId) {
        return apiError(
          "Saved Facebook Page ID missing hai.",
          400
        );
      }

      const resolved = await resolveReconnectPageToken(
        suppliedToken,
        savedPageId
      );

      const testedPage = await testFacebookPage(
        savedPageId,
        resolved.pageToken
      );

      const updatedRecord = await airtableFetch({
        baseId,
        token,
        table: TABLE_NAME,
        recordId,
        method: "PATCH",
        fields: {
          fields: {
            "Page Name":
              testedPage.name ||
              resolved.pageName ||
              stringValue(record.fields?.["Page Name"]),
            "Page Token": resolved.pageToken,
            Active: true,
          },
        },
      });

      return apiSuccess({
        message:
          `${testedPage.name || resolved.pageName || "Facebook Page"} ` +
          `successfully reconnect aur activate ho gaya.`,
        page: normalizeRecord(updatedRecord),
        tokenSource: resolved.source,
      });
    }

    const fields: Record<string, unknown> = {};

    if (typeof body.active === "boolean") {
      fields.Active = body.active;
    }

    if (typeof body.isDefault === "boolean") {
      fields.Default = body.isDefault;
    }

    if (Object.keys(fields).length === 0) {
      return apiError("Update ke liye koi valid field nahi mili.", 400);
    }

    const record = await airtableFetch({
      baseId,
      token,
      table: TABLE_NAME,
      recordId,
      method: "PATCH",
      fields: { fields },
    });

    return apiSuccess({
      message: "Facebook Page update ho gaya.",
      page: normalizeRecord(record),
    });
  } catch (error) {
    return handleApiError(error, "Facebook Page update failed");
  }
}

export async function DELETE(request: NextRequest) {
  try {
    await requireAdmin();
    const { baseId, token } = getAdminBaseConfig();
    const recordId = request.nextUrl.searchParams.get("recordId")?.trim();

    if (!recordId) {
      return apiError("Facebook Page record ID missing hai.", 400);
    }

    await airtableFetch({
      baseId,
      token,
      table: TABLE_NAME,
      recordId,
      method: "DELETE",
    });

    return apiSuccess({
      message: "Facebook Page delete ho gaya.",
    });
  } catch (error) {
    return handleApiError(error, "Facebook Page delete failed");
  }
}